# --- Required in production (the site refuses admin sign-in without these) ---
# Long random string used to sign admin sessions.
JWT_SECRET=
# Set ONE of these. The hash is preferred: `npm run hash:password "your passphrase"`.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Database (MongoDB Atlas). Without it the site runs from bundled content and an in-memory store. ---
MONGODB_URI=
MONGODB_DB=
MAX_REVISIONS=30

# --- Images and video (Cloudinary, signed direct upload) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# --- Bookings ---
# Requests wait for an admin to confirm them. Confirming creates a private Jitsi Meet room per booking
# (https://meet.jit.si/IP3-<ref>-<random>). Set MEETING_LINK to use one standing room instead (Zoom, Meet, Teams),
# or MEETING_BASE_URL to use your own Jitsi server.
MEETING_LINK=
MEETING_BASE_URL=
MEETING_MINUTES=

# --- Privacy: enquiries and bookings are deleted this many days after they arrive (bookings: after the meeting) ---
RETENTION_DAYS=60

# --- Public origin, used for canonical URLs, the sitemap and structured data (build time) ---
VITE_SITE_URL=https://ip3-bd.org

# --- Optional ---
SESSION_DAYS=7
# Only if the API is served from a different site than the pages.
CORS_ORIGIN=
COOKIE_SAMESITE=
VITE_API_BASE_URL=
