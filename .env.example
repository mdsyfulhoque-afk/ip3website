# --- Required in production (the site refuses admin sign-in without these) ---
# Long random string used to sign admin sessions.
JWT_SECRET=
# Set ONE of these. The hash is preferred: `npm run hash:password "your passphrase"`.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Database (MongoDB Atlas). Without it the site runs from bundled content and an in-memory store. ---
MONGODB_URI=
MONGODB_DB=
MAX_REVISIONS=30

# --- Images and video (Cloudinary, signed direct upload) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# --- Bookings ---
MEETING_LINK=
MEETING_MINUTES=

# --- Public origin, used for canonical URLs, the sitemap and structured data (build time) ---
VITE_SITE_URL=https://ip3-bd.org

# --- Optional ---
SESSION_DAYS=7
# Only if the API is served from a different site than the pages.
CORS_ORIGIN=
COOKIE_SAMESITE=
VITE_API_BASE_URL=
