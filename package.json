{
  "name": "ip3-website",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "tsc --noEmit && tsx scripts/make-knowledge.ts && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "start": "cross-env NODE_ENV=production node server.js",
    "preview": "npm run build && npm run start",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "assets": "tsx scripts/make-contours.ts && node scripts/make-icons.mjs",
    "map": "tsx scripts/make-map.ts",
    "knowledge": "tsx scripts/make-knowledge.ts",
    "check:placeholders": "tsx scripts/list-placeholders.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:force": "tsx scripts/seed.ts --force",
    "hash:password": "node scripts/hash-password.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/noto-serif-bengali": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@react-three/fiber": "^9.8.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "gsap": "^3.15.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "mongoose": "^8.9.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router": "^7.18.4",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.13.0",
    "bd-geojson": "^1.0.5",
    "cross-env": "^7.0.3",
    "d3-contour": "^4.0.2",
    "d3-geo": "^3.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7",
    "world-atlas": "^2.0.2"
  },
  "description": "IP3 Consulting Limited (Institute for Public Policy and Practice): public site, content studio, enquiry and booking API."
}
